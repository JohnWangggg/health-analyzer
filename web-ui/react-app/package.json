{
  "name": "@health-analyzer/react-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dual-track React preview shell — not the production default entry",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
